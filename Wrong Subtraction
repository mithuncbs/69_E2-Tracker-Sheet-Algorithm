#include <iostream>

using namespace std;

int main()
{
    long long s, x;
    if (cin >> s >> x)
    {
        while (x > 0)
        {
            if (s % 10 == 0)
                s /= 10;
            else
                s--;

            x--;
        }

        cout << s << "\n";
    }

    return 0;
}
