#include <iostream>
using namespace std;

void solve()
{
    int n;
    cin >> n;

    int a[105];
    for (int i = 0; i < n; i++)
        cin >> a[i];

    bool possible = true;
    int first_parity = a[0] % 2;

    for (int i = 1; i < n; i++)
    {
        if (a[i] % 2 != first_parity)
        {
            possible = false;
            break;
        }
    }

    if (possible)
        cout << "YES\n";
    else
        cout << "NO\n";
}

int main()
{
    int t;
    cin >> t;

    while (t--)
        solve();

    return 0;
}
