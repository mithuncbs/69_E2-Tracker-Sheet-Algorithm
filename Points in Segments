#include <bits/stdc++.h>
using namespace std;

int main()
{
    int T;
    cin >> T;
    for (int j = 1; j <= T; j++)
    {
        int n, q;
        cin >> n >> q;

        vector<int> points(n);
        for (int i = 0; i < n; i++)
            cin >> points[i];

        cout << "Case " << j << ":\n";
        while (q--)
        {
            int A, B;
            cin >> A >> B;

            auto it1 = lower_bound(points.begin(), points.end(), A);
            auto it2 = upper_bound(points.begin(), points.end(), B);

            cout << (it2 - it1) << "\n";

        }
    }
    
    return 0;
}
