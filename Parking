#include <bits/stdc++.h>
using namespace std;


int main()
{
    int t;
    cin >> t;

    while (t--)
    {
        {
            int n;
            cin >> n;

            int maxPos = -1000;
            int minPos = 1000;

            for (int i = 0; i < n; i++)
            {
                int x;
                cin >> x;

                maxPos = max(maxPos, x);
                minPos = min(minPos, x);
            }

            int totalDist = (maxPos - minPos) * 2;
            cout << totalDist << endl;
        }
    }

    return 0;
}
