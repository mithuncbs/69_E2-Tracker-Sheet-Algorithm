#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

int main()
{
    string s;
    cin >> s;

    int arr[100];
    int count = 0;

    for (int i = 0; i < s.length(); i += 2)
    {
        arr[count] = s[i] - '0';
        count++;
    }

    sort(arr, arr + count);

    for (int i = 0; i < count; i++)
    {
        cout << arr[i];
        if (i != count - 1)
        {
            cout << "+";
        }
    }
    cout << endl;

    return 0;
}
