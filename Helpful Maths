#include <bits/stdc++.h>
using namespace std;

int main()
{
    string s;
    cin >> s;

    string arr;
    int count = 0;

    for (int i = 0; i < s.length(); i++)
    {
        if (s[i] != '+')
            arr.push_back(s[i]);
    }

    sort(arr.begin(), arr.end());

    cout << arr[0];
    for (int i = 1; i < arr.length(); i++)
    {
        cout << "+";
        cout << arr[i];
    }

    cout << endl;

    return 0;
}
