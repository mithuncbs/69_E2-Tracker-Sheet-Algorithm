#include <bits/stdc++.h>
using namespace std;

int main()
{
    string s;
    cin >> s;

    char arr[s.length()];
    int count = 0;

    for (int i = 0; i < s.length(); i++)
    {
        if (s[i] != '+')
        {
            arr[count] = s[i];
            count++;
        }
    }

    sort(arr, arr + count);

    for (int i = 0; i < count; i++)
    {
        cout << arr[i];

        if (i != count - 1)
            cout << "+";
    }

    cout << endl;

    return 0;
}
