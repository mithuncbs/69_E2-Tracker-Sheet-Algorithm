#include <iostream>
using namespace std;

int main()
{
    int n;
    cin >> n;

    long long sum1 = 0, sum2 = 0, sum3 = 0;

    for (int i = 0; i < n; i++)
    {
        long long val;
        cin >> val;
        sum1 += val;
    }

    for (int i = 0; i < n - 1; i++)
    {
        long long val;
        cin >> val;
        sum2 += val;
    }

    for (int i = 0; i < n - 2; i++)
    {
        long long val;
        cin >> val;
        sum3 += val;
    }

    cout << sum2 - sum3 << endl;
    cout << sum1 - sum2 << endl;

    return 0;
}
