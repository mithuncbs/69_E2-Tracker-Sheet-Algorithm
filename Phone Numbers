#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

int main()
{
    int n;
    cin >> n;

    string s;
    cin >> s;

    int count = 0;
    for (int i = 0; i < s.length(); i++)
    {
        if (s[i] == '8')
            count++;
    }

    int ans = min(count, n / 11);

    cout << ans << endl;

    return 0;
}
