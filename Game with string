#include <iostream>
#include <string>

using namespace std;

int main()
{
    string s;
    cin >> s;

    int temp = -1;
    int moves = 0;

    for (int i = 0; i < s.length(); i++)
    {
        if (temp >= 0 && s[temp] == s[i])
        {
            temp--;
            moves++;
        }
        else
        {
            temp++;
            s[temp] = s[i];
        }
    }

    if (moves % 2 != 0)
        cout << "Yes" << endl;
    else
        cout << "No" << endl;

    return 0;
}
