#include <bits/stdc++.h>
using namespace std;

int main()
{
    string s;
    cin >> s;

    string st;
    int moves = 0;

    for (int i = 0; i < s.length(); i++)
    {
        if (st.length() > 0 && st[st.length() - 1] == s[i])
        {
            st.pop_back();
            moves++;
        }
        else  
            st.push_back(s[i]);
    }

    if (moves % 2 != 0)
        cout << "Yes" << endl;
    else
        cout << "No" << endl;

    return 0;
}
