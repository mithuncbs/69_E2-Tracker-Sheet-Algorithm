#include <iostream>
#include <string>
#include <cmath>
#include <algorithm>
using namespace std;

int main()
{

    int n;
    cin >> n;

    string a, b;
    cin >> a >> b;

    int moves = 0;

    for (int i = 0; i < n; i++)
    {
        int diff = abs(a[i] - b[i]);

        moves += min(diff, 10 - diff);
    }

    cout << moves << endl;

    return 0;
}
