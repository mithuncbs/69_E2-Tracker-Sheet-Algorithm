#include <iostream>
using namespace std;

int main()
{
    int T;
    cin >> T;

    for (int t = 1; t <= T; ++t)
    {
        int N;
        cin >> N;

        int max = 0;
        for (int i = 0; i < N; ++i)
        {
            int temp;
            cin >> temp;

            if (temp > max)
                max = temp;
        }

        cout << "Case " << t << ": " << max << endl;
    }

    return 0;
}
