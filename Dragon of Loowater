#include <iostream>
#include <algorithm>
using namespace std;


int main()
{
    int n, m;
    
    int heads[20005];
    int knights[20005];

    while (cin >> n >> m && (n != 0 || m != 0))
    {

        for (int i = 0; i < n; i++)
            cin >> heads[i];
        for (int i = 0; i < m; i++)
            cin >> knights[i];

        sort(heads, heads + n);
        sort(knights, knights + m);

        long long totalc = 0;
        int headc = 0;
        int knightc = 0;

        while (headc < n && knightc < m)
        {
            if (knights[knightc] >= heads[headc])
            {
                totalc += knights[knightc];
                headc++;
            }

            knightc++; 
        }

        if (headc == n)
            cout << totalc << endl;
        else
            cout << "Loowater is doomed!" << endl;
    }

    return 0;
}
