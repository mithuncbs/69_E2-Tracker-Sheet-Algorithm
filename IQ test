#include <iostream>
using namespace std;

int main()
{
    int n;
    cin >> n;

    int evenc = 0, oddc = 0;
    int eveni = 0, oddi = 0;

    for (int i = 1; i <= n; i++)
    { 
        int num;
        cin >> num;

        if (num % 2 == 0)
        {
            evenc++;
            eveni = i;
        }
        else
        {
            oddc++;
            oddi = i;
        }
    }

    if (evenc == 1)
        cout << eveni << endl;
    else
        cout << oddi << endl;

    return 0;
}
