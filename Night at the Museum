#include <iostream>
#include <string>
#include <cmath>
#include <algorithm>
using namespace std;

int main()
{
    string s;
    cin >> s;

    char current = 'a';
    int total = 0;

    for (int i = 0; i < s.length(); i++)
    {
        int diff = abs(s[i] - current);

        total += min(diff, 26 - diff);

        current = s[i];
    }

    cout << total << endl;

    return 0;
}
