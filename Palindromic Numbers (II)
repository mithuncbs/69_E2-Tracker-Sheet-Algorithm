#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;

    for (int i = 1; i <= t; i++)
    {
        string s;
        cin >> s;

        string p = s;

        reverse(s.begin(), s.end());

        if (p == s)
            cout << "Case " << i << ": Yes\n";
        else
            cout << "Case " << i << ": No\n";
    }

    return 0;
}
