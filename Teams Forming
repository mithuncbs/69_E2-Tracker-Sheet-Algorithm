#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cin >> n;

    int arr[n];

    for (int i = 0; i < n; i++)
        cin >> arr[i];

    sort(arr, arr + n);

    int total = 0;

    for (int i = 0; i < n; i += 2)
        total += (arr[i + 1] - arr[i]);

    cout << total << endl;

    return 0;
}
