#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

double p, q, r, s, t, u;

double f(double x)
{
    return p * exp(-x) + q * sin(x) + r * cos(x) + s * tan(x) + t * x * x + u;
}

int main()
{
    while (cin >> p >> q >> r >> s >> t >> u)
    {
        if (f(0) < 0 || f(1) > 0)
        {
            cout << "No solution\n";
            continue;
        }

        double low = 0.0, high = 1.0;

        for (int i = 0; i < 50; i++)
        {
            double mid = low + (high - low) / 2.0;
            
            if (f(mid) > 0)
                low = mid;
            else
                high = mid;
        }

        cout << fixed << setprecision(4) << low << "\n";
    }

    return 0;
}
